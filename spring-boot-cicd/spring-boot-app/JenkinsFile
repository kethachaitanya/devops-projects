
pipeline {
    agent {
        docker {
            image 'abhishekf5/maven-abhishek-docker-agent:v1'
            args '--user 105:109 --group-add 110 -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
    }

    environment {
        // Repository layout
        PROJECT_DIR = 'spring-boot-cicd'
        APP_DIR = "${PROJECT_DIR}/spring-boot-app"
        MANIFEST_DIR = "${PROJECT_DIR}/spring-boot-app-manifests"
        MANIFEST_FILE = "${MANIFEST_DIR}/deployment.yml"
        SCRIPTS_DIR = "${PROJECT_DIR}/scripts"

        // Docker Hub
        DOCKER_REPO = 'chaitanya0004/ultimate-cicd'

        // GitHub
        GIT_USER_NAME = 'kethachaitanya'
        GIT_REPO_NAME = 'devops-projects'
        GIT_BRANCH_NAME = 'main'

        // SonarQube
        SONAR_URL = '-Dsonar.host.url=http://172.31.39.60:9000'

        // Kubernetes and Argo CD
        NAMESPACE = 'sample-app'
        DEPLOYMENT_NAME = 'spring-boot-app'
        ARGO_APP = 'spring-boot-app'
    }

    stages {

        stage('Checkout and Validate') {
            steps {
                checkout scm

                sh '''
                    set -eu

                    echo "Current workspace:"
                    pwd

                    echo "Checking project structure..."

                    test -f "$APP_DIR/pom.xml" || {
                        echo "ERROR: pom.xml not found at $APP_DIR/pom.xml"
                        find . -maxdepth 5 -name pom.xml -print
                        exit 1
                    }

                    test -f "$APP_DIR/Dockerfile" || {
                        echo "ERROR: Dockerfile not found at $APP_DIR/Dockerfile"
                        find . -maxdepth 5 -name Dockerfile -print
                        exit 1
                    }

                    test -f "$MANIFEST_FILE" || {
                        echo "ERROR: Kubernetes manifest not found: $MANIFEST_FILE"
                        find . -maxdepth 5 \\( -name '*.yaml' -o -name '*.yml' \\) -print
                        exit 1
                    }

                    test -f "$SCRIPTS_DIR/trivy-scan.sh"
                    test -f "$SCRIPTS_DIR/update-gitops-image.sh"
                    test -f "$SCRIPTS_DIR/verify-rollout-and-rollback.sh"

                    git rev-parse --short HEAD
                '''
            }
        }

        stage('Build and Unit Test') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn -B clean verify'
                }
            }

            post {
                always {
                    junit(
                        allowEmptyResults: true,
                        testResults: "${APP_DIR}/target/surefire-reports/*.xml"
                    )

                    archiveArtifacts(
                        artifacts: "${APP_DIR}/target/*.jar",
                        allowEmptyArchive: true
                    )
                }
            }
        }




stage('Static Code Analysis') {
    steps {
        withSonarQubeEnv('sonarqube') {
            withCredentials([
                string(
                    credentialsId: 'sonarqube',
                    variable: 'SONAR_AUTH_TOKEN'
                )
            ]) {
                dir("${APP_DIR}") {
                    withEnv(["SONAR_USER_HOME=${WORKSPACE}/.sonar"]) {
                        sh '''
                            set -eu
                            mkdir -p "$SONAR_USER_HOME"

                            mvn -B \
                              org.sonarsource.scanner.maven:sonar-maven-plugin:5.2.0.4988:sonar \
                              "-Dsonar.host.url=$SONAR_HOST_URL" \
                              "-Dsonar.token=$SONAR_AUTH_TOKEN" \
                              "-Dsonar.projectKey=spring-boot-cicd"
                        '''
                    }
                }
            }
        }
    }
}


        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    def shortSha = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${shortSha}"
                    env.DOCKER_IMAGE = "${env.DOCKER_REPO}:${env.IMAGE_TAG}"
                }

                dir("${APP_DIR}") {
                    sh '''
                        docker build \
                          -t "$DOCKER_IMAGE" .
                    '''
                }

                echo "Built image: ${env.DOCKER_IMAGE}"
            }
        }

        stage('Scan Docker Image') {
            steps {
                sh '''
                    mkdir -p trivy-reports

                    chmod +x "$SCRIPTS_DIR/trivy-scan.sh"

                    "$SCRIPTS_DIR/trivy-scan.sh" "$DOCKER_IMAGE"
                '''
            }

            post {
                always {
                    archiveArtifacts(
                        artifacts: 'trivy-reports/**',
                        allowEmptyArchive: true
                    )
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        docker.image(env.DOCKER_IMAGE).push()
                    }
                }
            }
        }

        stage('Update GitOps Manifest') {
            when {
                branch 'main'
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        git config user.email \
                          "kethachaitanya0004@gmail.com"

                        git config user.name "chaitanya2004"

                        git remote set-url origin \
                          "https://x-access-token:${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git"

                        chmod +x "$SCRIPTS_DIR/update-gitops-image.sh"

                        "$SCRIPTS_DIR/update-gitops-image.sh" \
                          "$DOCKER_IMAGE" \
                          "$MANIFEST_FILE" \
                          "$GIT_BRANCH_NAME"
                    '''
                }
            }
        }

        stage('Verify Rollout and Rollback') {
            when {
                branch 'main'
            }

            steps {
                sh '''
                    chmod +x "$SCRIPTS_DIR/verify-rollout-and-rollback.sh"

                    "$SCRIPTS_DIR/verify-rollout-and-rollback.sh"
                '''
            }
        }
    }

    post {
        success {
            echo "CI/CD pipeline completed successfully."
            echo "Docker image: ${env.DOCKER_IMAGE}"
        }

        failure {
            echo 'Pipeline failed. Check the first failing stage in Console Output.'
        }

        always {
            cleanWs(
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
    }
}

